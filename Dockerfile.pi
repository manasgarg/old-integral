# The Pi image every deployment of this release runs. Integral builds it from
# this file unchanged; deployments cannot edit or replace it. The base image is
# pinned by digest and PI_VERSION must equal PI_VERSION in
# src/platform/constants.ts.
FROM node:26.13.0-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072

ARG PI_VERSION=1.5.2
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates gh git \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force \
    && groupmod --new-name pi node \
    && usermod --login pi --home /home/pi --move-home --shell /usr/sbin/nologin node

COPY --chmod=0555 bin/integral-pi-models.mjs /usr/local/bin/integral-pi-models

USER 1000:1000
WORKDIR /home/pi
