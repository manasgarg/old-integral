{
  "name": "@pirogram/integral",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "integral": "bin/integral.js"
  },
  "files": [
    "bin",
    "dist/src",
    "Dockerfile.pi",
    ".dockerignore",
    "README.md",
    "behavior"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:coverage && npm run behavior:coverage && npm run lifecycle:check && npm run package:check",
    "deploy": "npm run build && node dist/scripts/deploy-command.js",
    "build": "tsc && esbuild src/pi-extensions/web-tools.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/src/integral-web.mjs",
    "prepare": "npm run build",
    "behavior:coverage": "node scripts/check-behavior-coverage.ts",
    "lifecycle:check": "node scripts/check-lifecycle-specs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:check": "npm run build && node scripts/package-check.ts",
    "pack:check": "npm pack --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:acceptance": "npm run build && node --test --test-concurrency=1 dist/test/acceptance/process.acceptance.test.js",
    "test:acceptance:docker": "npm run build && node --test --test-concurrency=1 dist/test/acceptance/docker.acceptance.test.js",
    "test:full": "npm test && npm run test:acceptance && npm run test:acceptance:docker",
    "test:coverage": "npm run build && node --experimental-test-coverage --test --test-concurrency=1 --test-coverage-include=dist/src/**/*.js --test-coverage-lines=50 --test-coverage-branches=75 --test-coverage-functions=60 dist/test/*.test.js"
  },
  "dependencies": {
    "defuddle": "0.19.6",
    "discord.js": "14.28.1",
    "linkedom": "0.18.15",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
